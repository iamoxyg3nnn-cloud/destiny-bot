FROM node:22-bookworm-slim AS builder

WORKDIR /app
RUN npm install --global pnpm@9.15.9
COPY package.json pnpm-lock.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile

COPY src ./src
COPY apps ./apps
RUN pnpm build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN npm install --global pnpm@9.15.9 \
  && groupadd --system --gid 10001 destiny \
  && useradd --system --uid 10001 --gid destiny --home-dir /app destiny

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile \
  && pnpm store prune \
  && npm uninstall --global pnpm

COPY --from=builder --chown=destiny:destiny /app/dist ./dist
COPY --from=builder --chown=destiny:destiny /app/apps ./apps

USER destiny
EXPOSE 3000
CMD ["node", "dist/src/dashboard/server.js"]
