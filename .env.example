# =================================================================
# DESTINY BOT — ENVIRONMENT CONFIGURATION
# =================================================================

# ----------------- Discord Configuration -----------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_SHARDS_TOTAL=auto
DISCORD_SHARDS_PER_CLUSTER=2

# ----------------- Supabase PostgreSQL Database -----------------
# Permanent storage for users, rooms, chat audit, coin ledger, and moderation
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres

# ----------------- Redis & BullMQ Configuration -----------------
# Distributed matchmaking, locks, active sessions, rate limits & queueing
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=destiny:

# ----------------- Worker & Notification Settings -----------------
# Scheduled daily reminder at 7:30 PM IST (19:30 Asia/Kolkata)
REMINDER_CRON_SCHEDULE="30 19 * * *"
REMINDER_DEFAULT_TIMEZONE=Asia/Kolkata
BULLMQ_CONCURRENCY=50

# ----------------- Dashboard & API Server -----------------
PORT=4000
API_SECRET_KEY=destiny_super_secret_internal_jwt_key_32bytes!
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_SECRET=destiny_nextauth_secret_key_change_in_production
NEXTAUTH_URL=http://localhost:3000

# ----------------- Moderation & Security -----------------
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTO_MOD_ENABLED=true
MAX_MESSAGE_RATE_PER_3S=5
MAX_QUEUE_WAIT_SECONDS=180
LOG_LEVEL=info
NODE_ENV=development
