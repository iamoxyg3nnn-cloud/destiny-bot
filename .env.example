# =================================================================
# DESTINY BOT — ENVIRONMENT CONFIGURATION
# =================================================================

# ----------------- Discord Configuration -----------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
# Comma-separated Discord user IDs with global bot-owner authority (not server admins).
BOT_OWNER_IDS=
DESTINY_STREAM_URL=https://www.twitch.tv/ninja
DISCORD_SHARDS_TOTAL=auto
DISCORD_SHARDS_PER_CLUSTER=2

# ----------------- Supabase PostgreSQL Database -----------------
# Permanent storage for anonymous profiles, rooms, messages, reports and moderation.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Optional Management API token for project provisioning only; do not pass to runtime containers.
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres

# ----------------- Worker & Notification Settings -----------------
# Scheduled daily reminder at 7:30 PM IST (19:30 Asia/Kolkata)
REMINDER_CRON_SCHEDULE="30 19 * * *"
REMINDER_DEFAULT_TIMEZONE=Asia/Kolkata

# ----------------- Moderation & Security -----------------
ENCRYPTION_KEY=
AUTO_MOD_ENABLED=true
MAX_MESSAGE_RATE_PER_3S=5
MAX_QUEUE_WAIT_SECONDS=180
LOG_LEVEL=info
NODE_ENV=development
